# --- LLM gateway (OpenAI-compatible /chat/completions; set LLM_API_STYLE=anthropic for /v1/messages)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_VISION_MODEL=claude-sonnet-5-5
LLM_API_STYLE=openai

# --- Download
DOWNLOAD_RATE_LIMIT=          # e.g. 4M (bytes/s). empty = unlimited
DOWNLOAD_CONCURRENT_FRAGMENTS=4
PREVIEW_HEIGHT=360            # stage-1 preview height; 0 = audio only
SECTION_PADDING=5             # seconds added before/after each HQ section
MAX_HEIGHT=1080
COOKIES_FILE=                 # Netscape cookies.txt for sub-only VODs

# --- Transcription
WHISPER_MODEL=auto            # auto | large-v3 | medium | small | ...
WHISPER_LANGUAGE=auto
TRANSCRIBE_SCOPE=auto         # auto | full | candidates

# --- Render
VIDEO_BITRATE=14M
REMOTION_CONCURRENCY=0        # 0 = all cores
REMOTION_LICENSE_KEY=free-license
MAX_FPS=60

# --- Server
CLIPFARM_HOST=127.0.0.1
CLIPFARM_PORT=8765
